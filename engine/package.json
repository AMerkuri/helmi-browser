{
  "name": "serene-engine",
  "version": "0.1.0",
  "description": "Serene hybrid annoyance engine prototype (filter lists + overlay detector + on-device LLM)",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "model": "node-llama-cpp pull --dir models --filename Qwen3-0.6B-Q8_0.gguf https://huggingface.co/Qwen/Qwen3-0.6B-GGUF/resolve/main/Qwen3-0.6B-Q8_0.gguf",
    "model:fallback": "node-llama-cpp pull --dir models --filename qwen2.5-0.5b-instruct-q8_0.gguf https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q8_0.gguf",
    "llm-eval": "node test/llm-eval.mjs --model models/Qwen3-0.6B-Q8_0.gguf",
    "crawl": "node harness/run.mjs --model models/Qwen3-0.6B-Q8_0.gguf",
    "crawl:no-model": "node harness/run.mjs --modes baseline,rules"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "adblock-rs": "^0.13.3",
    "node-llama-cpp": "^3.22.2",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
